9bf0b89b/7ba76d37437a45c3ab150aefc4887a31.jpeg", "height": 90}, {"size": 2653, "width": 100, "url": "https://media.sketchfab.com/avatars/e7dea91656be48fe8370df909bf0b89b/44586482e5644d64b0687d0a69f627be.jpeg", "height": 100}]}, "uri": "https://api.sketchfab.com/v3/users/5a873b6f19014bfeabf80239bda7b4f8"}, "description": "Rayman, more commonly known as Rayman 1, is the first game in the Rayman series and features the debut of the titular character. The game was first released in 1995 on the Sony PlayStation, Atari Jaguar, Sega Saturn, and PC/MS-DOS. The game was later ported to the Game Boy Advance in 2001, under the name Rayman Advance, Nintendo DSi in 2009 and iOS and Android in 2016, under the name Rayman Classic.\n\nThe PlayStation version was released in 2008 on the PlayStation Network as a downloadable PSOne Classic, playable on PlayStation Portable, PlayStation 3 and PlayStation Vita. The Nintendo DSi version was released alongside other DSiWare titles on the Nintendo eShop for the Nintendo 3DS family of systems. On December 3, 2018, the PlayStation version was re-released with the PlayStation Classic. This version was the NTSC version for all territories.", "faceCount": 1049710, "createdAt": "2025-11-22T12:40:54.005596", "vertexCount": 524903, "isAgeRestricted": false, "archives": {"glb": {"textureCount": 0, "size": 30103808, "type": "glb", "textureMaxResolution": 0, "faceCount": 1049710, "vertexCount": 546230}, "gltf": {"textureCount": 0, "size": 16333527, "type": "gltf", "textureMaxResolution": 0, "faceCount": 1049710, "vertexCount": 546230}, "source": {"textureCount": null, "size": 56839391, "type": "source", "textureMaxResolution": null, "faceCount": null, "vertexCount": null}, "usdz": {"textureCount": null, "size": 13856134, "type": "usdz", "textureMaxResolution": null, "faceCount": null, "vertexCount": null}}, "license": {"uid": "322a749bcfa841b29dff1e8a1bb74b0b", "label": "CC Attribution"}}]}