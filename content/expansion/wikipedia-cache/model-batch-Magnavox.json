rname": "Fireteriti", "displayName": "Fireteriti", "profileUrl": "https://sketchfab.com/Fireteriti", "account": "basic", "avatar": {"uri": "https://api.sketchfab.com/v3/avatars/4da7e53d513d46eb93359536264e5fb0", "images": [{"size": 856, "width": 32, "url": "https://media.sketchfab.com/avatars/4da7e53d513d46eb93359536264e5fb0/559e749de2ef4d0582769928d5909406.jpeg", "height": 32}, {"size": 1419, "width": 48, "url": "https://media.sketchfab.com/avatars/4da7e53d513d46eb93359536264e5fb0/03b9d94dbddc4642bff8d3b7ede01d0c.jpeg", "height": 48}, {"size": 3657, "width": 90, "url": "https://media.sketchfab.com/avatars/4da7e53d513d46eb93359536264e5fb0/292fd3ed551c485abda5237376239ee3.jpeg", "height": 90}, {"size": 4215, "width": 100, "url": "https://media.sketchfab.com/avatars/4da7e53d513d46eb93359536264e5fb0/d622b28460d94fccab0cebfa731ecbc7.jpeg", "height": 100}]}, "uri": "https://api.sketchfab.com/v3/users/1ec47010f55b42beba7fce2018803d58"}, "description": "Pong is one of the earliest arcade video games and the first sports arcade video game. It is a table tennis sports game featuring simple two-dimensional graphics. While other arcade video games such as Computer Space came before it, Pong was one of the first video games to reach mainstream popularity. The game was originally manufactured by Atari, which released it in 1972. Allan Alcorn created Pong as a training exercise assigned to him by Atari co-founder Nolan Bushnell. Bushnell based the idea on an electronic ping-pong game included in the Magnavox Odyssey, which later resulted in a lawsuit against Atari. Surprised by the quality of Alcorn's work, Bushnell and Atari co-founder Ted Dabney decided to manufacture the game.\n\nOne Of My Favorite Games Of All TIme.", "faceCount": 42, "createdAt": "2017-05-20T15:25:21.220474", "vertexCount": 23, "isAgeRestricted": false, "archives": {"glb": {"textureCount": 0, "size": 12344, "type": "glb", "textureMaxResolution": 0, "faceCount": 84, "vertexCount": 168}, "gltf": {"textureCount